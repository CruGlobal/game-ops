# GitHub Configuration
GITHUB_TOKEN=your_github_token_here  # NOTE: Requires 'read:org' scope for DevOps team sync
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_ORG=your_github_org_here  # GitHub organization name (defaults to REPO_OWNER if not set)

# Repository Configuration
REPO_OWNER=your_repo_owner_here
REPO_NAME=your_repo_name_here

# Base URL Configuration (used to derive callback URLs, CORS, etc.)
BASE_URL=http://localhost:3000
# Derived automatically:
# - GITHUB_CALLBACK_URL = ${BASE_URL}/auth/github/callback
# - CORS_ORIGIN = ${BASE_URL}
# - DOMAIN = ${BASE_URL}

# DevOps Team Configuration
DEVOPS_TEAM_SLUG=devops-engineering-team  # GitHub team slug for admin access and DevOps team sync

# Database Configuration (PostgreSQL)
# Local PostgreSQL:
DATABASE_URL=postgresql://username:password@localhost:5432/game_ops
# OR Neon (cloud PostgreSQL):
# DATABASE_URL=postgresql://username:password@ep-xxx-xxx.region.neon.tech/github_scoreboard?sslmode=require

# Application Configuration
NODE_ENV=development
# The listen port is not configurable: server.js uses a fixed 3000. PORT was listed
# here but never read.
SESSION_SECRET=your_random_session_secret_here  # REQUIRED in production; the app refuses to boot without it

# Logging Configuration
LOG_LEVEL=info
PRISMA_LOGGING=false

# Authentication Bypass (local development only)
# Set to 'true' to skip GitHub OAuth and DevOps team checks
# DISABLE_AUTH=true

# Socket.IO is always on; there is no ENABLE_WEBSOCKET switch in the code. The variable
# was documented here but never read.

# Slack Notifications (optional — can also be configured in admin UI)
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T.../B.../...

# Bills API (optional — auto-sends bill bucks to podium winners at period boundaries)
# Requires the "Send Bill Bucks via Bills API" toggle to be enabled in the admin UI.
# BILLS_API_KEY must be a fund-tied key with bills:read + bills:give scopes.
BILLS_API_KEY=your_bills_api_key_here  # e.g. bk_...
# BILLS_API_URL defaults to https://bills.ustech.app/api/v1 (bare origin also accepted)
# BILLS_API_URL=https://bills.ustech.app/api/v1

# GitHub Webhook Configuration
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here  # Shared secret for HMAC SHA-256 signature verification

# MCP server (optional — bearer token for the /mcp endpoint)
# MCP_BEARER_TOKEN=your_mcp_bearer_token_here

# CORS (optional — comma-separated allowlist; defaults to BASE_URL)
# CORS_ORIGINS=https://game-ops.cru.org

# Cross-origin isolation headers (optional; always on when NODE_ENV=production)
# ENABLE_COEP=true

# Removed: JWT_SECRET, ADMIN_USERNAME and ADMIN_PASSWORD are no longer read. The
# JWT/password admin login was deleted — authentication is GitHub OAuth plus the
# httpOnly session cookie, and admin access is DevOps team membership.
